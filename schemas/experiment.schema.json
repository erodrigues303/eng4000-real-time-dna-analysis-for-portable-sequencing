{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "date",
    "owner",
    "status",
    "tool",
    "model_ids",
    "dataset_id",
    "system_id",
    "scenario_id",
    "command",
    "shell",
    "working_directory",
    "environment",
    "settings",
    "warmup_count",
    "measured_run_count",
    "workload_repetitions",
    "timing_scope",
    "telemetry",
    "output_format",
    "output_validation",
    "artifacts",
    "provenance",
    "limitations"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "historical-preliminary",
        "planned",
        "validated"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "model_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataset_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "system_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "command": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "shell": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "working_directory": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_size",
        "overlap",
        "batch_size",
        "caller_threads",
        "beam_size"
      ],
      "properties": {
        "chunk_size": {
          "oneOf": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        },
        "overlap": {
          "oneOf": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        },
        "batch_size": {
          "oneOf": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        },
        "caller_threads": {
          "oneOf": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        },
        "beam_size": {
          "oneOf": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        }
      }
    },
    "warmup_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "measured_run_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "workload_repetitions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "timing_scope": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_method",
        "memory_method",
        "power_method",
        "power_scope",
        "sampling_interval_s"
      ],
      "properties": {
        "timing_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "memory_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "power_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "power_scope": {
          "enum": [
            null,
            "cpu-package",
            "gpu-device",
            "jetson-module-input",
            "whole-system",
            "unknown"
          ]
        },
        "sampling_interval_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "output_format": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "output_validation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "sha256",
          "description"
        ],
        "properties": {
          "location": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string"
          },
          "warmup_count": {
            "type": "integer"
          },
          "measured_run_count": {
            "type": "integer",
            "minimum": 1
          },
          "artifacts": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
