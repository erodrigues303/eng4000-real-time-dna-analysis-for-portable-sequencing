{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system_id",
    "name",
    "cpu",
    "gpu",
    "ram",
    "os",
    "architecture",
    "cuda",
    "driver",
    "jetpack",
    "power_mode",
    "provenance",
    "limitations"
  ],
  "properties": {
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cpu": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "gpu": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "ram": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "os": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "architecture": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cuda": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "driver": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "jetpack": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "power_mode": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
